// Процедура обновляет ИИН и ФОТ сотрудников в HR Time Tracking
//
Процедура ОбновитьДанныеСотрудников() Экспорт

	МассивСотрудников = Новый Массив;

	// Выборка сотрудников с ИИН и ФОТ
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.ТабельныйНомер КАК table_number,
	|	Сотрудники.ИНН КАК iin,
	|	Сотрудники.Оклад КАК payroll
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления
	|	И НЕ Сотрудники.Уволен
	|	И Сотрудники.ИНН <> """"";

	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаСотрудников = РезультатЗапроса.Выбрать();

	Пока ВыборкаСотрудников.Следующий() Цикл

		СтруктураСотрудника = Новый Структура;
		СтруктураСотрудника.Вставить("table_number", ВыборкаСотрудников.table_number);
		СтруктураСотрудника.Вставить("iin", ВыборкаСотрудников.iin);
		СтруктураСотрудника.Вставить("payroll", Число(ВыборкаСотрудников.payroll));

		МассивСотрудников.Добавить(СтруктураСотрудника);

	КонецЦикла;

	// Отправка данных
	РезультатОтправки = ОтправитьДанныеВHRSystem(
		"/api/admin/employees/update-iin",
		МассивСотрудников
	);

	Если РезультатОтправки.success Тогда
		Сообщить("✅ Обновлено сотрудников: " + РезультатОтправки.updated);
		Если РезультатОтправки.notFound > 0 Тогда
			Сообщить("⚠️ Не найдено сотрудников: " + РезультатОтправки.notFound);
		КонецЕсли;
	Иначе
		ВызватьИсключение "❌ Ошибка обновления сотрудников: " + РезультатОтправки.error;
	КонецЕсли;

КонецПроцедуры

