// Процедура выполняет массовое назначение графиков работы сотрудникам
//
Процедура НазначитьГрафикиСотрудникам() Экспорт

	СтруктураНазначений = Новый Структура;
	МассивНазначений = Новый Массив;

	// Выборка назначений графиков из регистра сведений
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НазначениеГрафиков.Сотрудник.ТабельныйНомер КАК employee_number,
	|	НазначениеГрафиков.График.Код КАК schedule_code,
	|	НазначениеГрафиков.ДатаНачала КАК start_date,
	|	НазначениеГрафиков.ДатаОкончания КАК end_date
	|ИЗ
	|	РегистрСведений.НазначениеГрафиковРаботы КАК НазначениеГрафиков
	|ГДЕ
	|	НазначениеГрафиков.ДатаНачала >= &ДатаНачалаПериода
	|	И НазначениеГрафиков.Сотрудник.Уволен = ЛОЖЬ";

	Запрос.УстановитьПараметр("ДатаНачалаПериода", НачалоГода(ТекущаяДата()));

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл

		СтруктураНазначения = Новый Структура;
		СтруктураНазначения.Вставить("employee_number", Выборка.employee_number);
		СтруктураНазначения.Вставить("schedule_code",
			Строка(Выборка.schedule_code.УникальныйИдентификатор()));
		СтруктураНазначения.Вставить("start_date",
			Формат(Выборка.start_date, "ДФ=yyyy-MM-dd"));
		СтруктураНазначения.Вставить("end_date",
			?(ЗначениеЗаполнено(Выборка.end_date),
			  Формат(Выборка.end_date, "ДФ=yyyy-MM-dd"),
			  Null));

		МассивНазначений.Добавить(СтруктураНазначения);

	КонецЦикла;

	СтруктураНазначений.Вставить("assignments", МассивНазначений);

	// Отправка данных
	РезультатОтправки = ОтправитьДанныеВHRSystem(
		"/api/admin/schedules/assign-employees-batch",
		СтруктураНазначений
	);

	Если РезультатОтправки.success Тогда
		Сообщить("✅ Назначено графиков: " + РезультатОтправки.results.assigned);
		Если РезультатОтправки.results.failed > 0 Тогда
			Сообщить("⚠️ Ошибок назначения: " + РезультатОтправки.results.failed);
			Для Каждого Ошибка Из РезультатОтправки.results.errors Цикл
				Сообщить("   - " + Ошибка);
			КонецЦикла;
		КонецЕсли;
	Иначе
		ВызватьИсключение "❌ Ошибка назначения графиков: " + РезультатОтправки.error;
	КонецЕсли;

КонецПроцедуры

