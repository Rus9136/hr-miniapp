// 1. ИМПОРТ ГРАФИКОВ РАБОТЫ
// ============================================================================

// Процедура выполняет полную выгрузку графиков работы в HR Time Tracking
//
// Параметры:
//   ПериодНачало - Дата - начало периода для выгрузки графиков
//   ПериодКонец  - Дата - конец периода для выгрузки графиков
//
Процедура ВыгрузитьГрафикиРаботы(ПериодНачало = Неопределено, ПериодКонец = Неопределено) Экспорт

	Если ПериодНачало = Неопределено Тогда
		ПериодНачало = НачалоГода(ТекущаяДата());
	КонецЕсли;

	Если ПериодКонец = Неопределено Тогда
		ПериодКонец = КонецГода(ТекущаяДата());
	КонецЕсли;

	// Подготовка структуры данных
	ДанныеВыгрузки = Новый Структура;
	ДанныеВыгрузки.Вставить("ДатаВыгрузки", ТекущаяДата());

	МассивГрафиков = Новый Массив;

	// Выборка графиков из справочника
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикиРаботы.Ссылка КАК График,
	|	ГрафикиРаботы.Наименование КАК НаименованиеГрафика,
	|	ГрафикиРаботы.Код КАК КодГрафика
	|ИЗ
	|	Справочник.ГрафикиРаботы КАК ГрафикиРаботы
	|ГДЕ
	|	НЕ ГрафикиРаботы.ПометкаУдаления
	|	И ГрафикиРаботы.Актуален";

	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаГрафиков = РезультатЗапроса.Выбрать();

	Пока ВыборкаГрафиков.Следующий() Цикл

		СтруктураГрафика = Новый Структура;
		СтруктураГрафика.Вставить("НаименованиеГрафика", ВыборкаГрафиков.НаименованиеГрафика);
		СтруктураГрафика.Вставить("КодГрафика", Строка(ВыборкаГрафиков.График.УникальныйИдентификатор()));

		// Получаем рабочие дни графика
		МассивРабочихДней = ПолучитьРабочиеДниГрафика(ВыборкаГрафиков.График, ПериодНачало, ПериодКонец);
		СтруктураГрафика.Вставить("РабочиеДни", МассивРабочихДней);

		МассивГрафиков.Добавить(СтруктураГрафика);

	КонецЦикла;

	ДанныеВыгрузки.Вставить("КоличествоГрафиков", МассивГрафиков.Количество());
	ДанныеВыгрузки.Вставить("Графики", МассивГрафиков);

	// Отправка данных в HR Time Tracking
	РезультатОтправки = ОтправитьДанныеВHRSystem(
		"/api/admin/schedules/import-1c",
		ДанныеВыгрузки,
		600 // Таймаут 10 минут для больших выгрузок
	);

	Если РезультатОтправки.success Тогда
		Сообщить("✅ Выгрузка графиков завершена успешно!");
		Сообщить("   Обработано графиков: " + РезультатОтправки.statistics.totalSchedulesProcessed);
		Сообщить("   Вставлено дней: " + РезультатОтправки.statistics.totalWorkDaysInserted);

		Если РезультатОтправки.statistics.errorsCount > 0 Тогда
			Сообщить("⚠️ Предупреждение: обнаружены ошибки (" + РезультатОтправки.statistics.errorsCount + ")");
			Для Каждого Ошибка Из РезультатОтправки.errors Цикл
				Сообщить("   - " + Ошибка);
			КонецЦикла;
		КонецЕсли;
	Иначе
		ВызватьИсключение "❌ Ошибка выгрузки графиков: " + РезультатОтправки.error;
	КонецЕсли;

КонецПроцедуры

// Функция формирует массив рабочих дней для графика
//
// Параметры:
//   ГрафикСсылка - СправочникСсылка.ГрафикиРаботы - график работы
//   ДатаНачала   - Дата - начало периода
//   ДатаОкончания - Дата - конец периода
//
// Возвращаемое значение:
//   Массив - массив структур с данными рабочих дней
//
Функция ПолучитьРабочиеДниГрафика(ГрафикСсылка, ДатаНачала, ДатаОкончания)

	МассивРабочихДней = Новый Массив;

	ТекущаяДата = ДатаНачала;
	Пока ТекущаяДата <= ДатаОкончания Цикл

		// Получаем данные о рабочем дне из графика
		// Используйте вашу функцию получения данных из графика работы
		ДанныеДня = РегистрыСведений.ДанныеГрафиковРаботы.ПолучитьДанныеДня(
			ГрафикСсылка,
			ТекущаяДата
		);

		// Определяем тип времени
		ВидУчетаВремени = "Рабочее время";
		КоличествоЧасов = 8;
		ВремяНачала = '09:00:00';
		ВремяОкончания = '18:00:00';

		Если ДанныеДня <> Неопределено Тогда

			Если ДанныеДня.ЭтоВыходной Тогда
				ВидУчетаВремени = "В"; // Выходной
				КоличествоЧасов = 0;
				ВремяНачала = Null;
				ВремяОкончания = Null;
			Иначе
				КоличествоЧасов = ДанныеДня.КоличествоЧасов;
				ВремяНачала = ДанныеДня.ВремяНачала;
				ВремяОкончания = ДанныеДня.ВремяОкончания;
			КонецЕсли;

		КонецЕсли;

		// Формируем структуру дня
		СтруктураДня = Новый Структура;
		СтруктураДня.Вставить("Дата", Формат(ТекущаяДата, "ДФ=yyyy-MM-dd"));
		СтруктураДня.Вставить("Месяц", Формат(НачалоМесяца(ТекущаяДата), "ДФ=yyyy-MM-dd"));
		СтруктураДня.Вставить("ВидУчетаВремени", ВидУчетаВремени);
		СтруктураДня.Вставить("ДополнительноеЗначение", КоличествоЧасов);
		СтруктураДня.Вставить("ВремяНачалоРаботы",
			?(ВремяНачала = Null, Null, Формат(ВремяНачала, "ДФ=HH:mm:ss")));
		СтруктураДня.Вставить("ВремяЗавершениеРаботы",
			?(ВремяОкончания = Null, Null, Формат(ВремяОкончания, "ДФ=HH:mm:ss")));

		МассивРабочихДней.Добавить(СтруктураДня);

		ТекущаяДата = ТекущаяДата + 86400; // +1 день

	КонецЦикла;

	Возврат МассивРабочихДней;

КонецФункции

