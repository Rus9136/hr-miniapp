// Процедура выполняет полную синхронизацию всех данных с HR Time Tracking
//
Процедура ПолнаяСинхронизацияСHRSystem() Экспорт

	Попытка

		НачатьТранзакцию();

		// Шаг 1: Выгрузка графиков работы
		Сообщить("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
		Сообщить("📊 Шаг 1/3: Выгрузка графиков работы...");
		ВыгрузитьГрафикиРаботы();

		// Шаг 2: Обновление данных сотрудников
		Сообщить("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
		Сообщить("👥 Шаг 2/3: Обновление данных сотрудников...");
		ОбновитьДанныеСотрудников();

		// Шаг 3: Назначение графиков сотрудникам
		Сообщить("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
		Сообщить("📅 Шаг 3/3: Назначение графиков сотрудникам...");
		НазначитьГрафикиСотрудникам();

		ЗафиксироватьТранзакцию();

		Сообщить("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
		Сообщить("✅ Полная синхронизация завершена успешно!");
		Сообщить("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");

		// Запись в журнал регистрации
		ЗаписьЖурналаРегистрации(
			"Синхронизация с HR Time Tracking",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Полная синхронизация данных завершена успешно"
		);

	Исключение

		ОтменитьТранзакцию();

		ТекстОшибки = ОписаниеОшибки();
		Сообщить("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
		Сообщить("❌ Ошибка синхронизации:");
		Сообщить(ТекстОшибки);
		Сообщить("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");

		// Запись в журнал регистрации
		ЗаписьЖурналаРегистрации(
			"Синхронизация с HR Time Tracking",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки
		);

		ВызватьИсключение ТекстОшибки;

	КонецПопытки;

КонецПроцедуры

