		// Остальные дни - только обновление данных сотрудников
		Сообщить("🔄 Запуск частичной синхронизации (обновление сотрудников)");
		ОбновитьДанныеСотрудников();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция отправляет данные в HR Time Tracking System
//
// Параметры:
//   Endpoint - Строка - путь API (например: "/api/admin/schedules/import-1c")
//   Данные   - Структура, Массив - данные для отправки
//   Таймаут  - Число - таймаут соединения в секундах (по умолчанию 60)
//
// Возвращаемое значение:
//   Структура - результат выполнения запроса
//
Функция ОтправитьДанныеВHRSystem(Endpoint, Данные, Таймаут = 60)

	Попытка

		// Создание HTTPS соединения
		Соединение = Новый HTTPСоединение(
			"madlen.space",        // Сервер
			443,                   // Порт HTTPS
			,                      // Пользователь
			,                      // Пароль
			,                      // Прокси
			Таймаут,               // Таймаут
			Новый ЗащищенноеСоединениеOpenSSL // SSL
		);

		// Создание HTTP запроса
		Запрос = Новый HTTPЗапрос(Endpoint);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

		// Формирование JSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Данные);
		JSONСтрока = ЗаписьJSON.Закрыть();

		// Установка тела запроса
		Запрос.УстановитьТелоИзСтроки(JSONСтрока, КодировкаТекста.UTF8);

		// Отправка запроса
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

		// Обработка ответа
		Если Ответ.КодСостояния = 200 Тогда

			// Парсинг JSON ответа
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
			РезультатОтвета = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();

			Возврат РезультатОтвета;

		ИначеЕсли Ответ.КодСостояния = 413 Тогда

			// Слишком большой размер данных
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("success", Ложь);
			СтруктураОшибки.Вставить("error",
				"Размер данных превышает допустимый лимит (500MB). Разбейте выгрузку на несколько пакетов.");
			Возврат СтруктураОшибки;

		Иначе

			// Другие HTTP ошибки
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("success", Ложь);
			СтруктураОшибки.Вставить("error",
				"HTTP ошибка " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку());
			Возврат СтруктураОшибки;

		КонецЕсли;

	Исключение

		// Ошибка соединения или обработки
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("success", Ложь);
		СтруктураОшибки.Вставить("error", "Ошибка отправки данных: " + ОписаниеОшибки());
		Возврат СтруктураОшибки;

	КонецПопытки;

КонецФункции

#КонецОбласти

