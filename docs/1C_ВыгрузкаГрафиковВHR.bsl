// Отправка графиков в HR систему
//
// Параметры:
//   МассивГрафиков - Массив - массив структур с данными графиков
//
Процедура ОтправитьГрафикиВHRСистему(МассивГрафиков)

    // Параметры подключения
    АдресСервера = "madlen.space";
    АдресAPI = "/api/admin/schedules/import-1c";

    // Подготовка данных для отправки
    ДанныеЗапроса = Новый Структура;
    ДанныеЗапроса.Вставить("ДатаВыгрузки", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd"));
    ДанныеЗапроса.Вставить("КоличествоГрафиков", МассивГрафиков.Количество());
    ДанныеЗапроса.Вставить("Графики", МассивГрафиков);

    // Преобразование в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеЗапроса);
    ТелоЗапроса = ЗаписьJSON.Закрыть();

    // Логирование размера запроса
    РазмерМБ = СтрДлина(ТелоЗапроса) / 1024 / 1024;
    Сообщить(СтрШаблон("Размер запроса: %1 МБ", Формат(РазмерМБ, "ЧДЦ=2")));

    // Создание HTTP-запроса
    Соединение = Новый HTTPСоединение(
        АдресСервера,
        443,    // HTTPS порт
        ,       // Пользователь
        ,       // Пароль
        ,       // Прокси
        120,    // Timeout 120 секунд
        Новый ЗащищенноеСоединениеOpenSSL  // SSL
    );

    Запрос = Новый HTTPЗапрос(АдресAPI);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);

    Попытка
        // Отправка запроса
        Сообщить("Отправка данных на сервер...");
        Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);

        // Обработка ответа
        Если Ответ.КодСостояния = 200 Тогда
            ОбработатьУспешныйОтвет(Ответ);
        Иначе
            ОбработатьОшибку(Ответ);
        КонецЕсли;

    Исключение
        // Логирование ошибки
        ТекстОшибки = ОписаниеОшибки();
        ЗаписьЖурналаРегистрации(
            "Выгрузка графиков в HR",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Ошибка отправки данных: " + ТекстОшибки
        );
        ВызватьИсключение ТекстОшибки;
    КонецПопытки;

КонецПроцедуры

// Обработка успешного ответа от сервера
//
// Параметры:
//   Ответ - HTTPОтвет
//
Процедура ОбработатьУспешныйОтвет(Ответ)

    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
    ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();

    Если ДанныеОтвета.Свойство("success") И ДанныеОтвета.success = Истина Тогда

        Статистика = ДанныеОтвета.statistics;

        ТекстСообщения = СтрШаблон(
            "✅ Импорт графиков завершен успешно:%1" +
            "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%1" +
            "📥 Получено графиков: %2%1" +
            "✔️  Обработано графиков: %3%1" +
            "🔄 Обновлено графиков: %4%1" +
            "📅 Вставлено рабочих дней: %5%1" +
            "⚠️  Предупреждений: %6",
            Символы.ПС,
            Статистика.totalSchedulesReceived,
            Статистика.totalSchedulesProcessed,
            Статистика.totalSchedulesUpdated,
            Статистика.totalWorkDaysInserted,
            Статистика.errorsCount
        );

        // Проверка наличия предупреждений
        Если ДанныеОтвета.Свойство("errors") И ДанныеОтвета.errors <> Неопределено Тогда
            ТекстСообщения = ТекстСообщения + Символы.ПС + Символы.ПС + "⚠️ Предупреждения:";
            ТекстСообщения = ТекстСообщения + Символы.ПС + "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━";
            Для Каждого Ошибка Из ДанныеОтвета.errors Цикл
                ТекстСообщения = ТекстСообщения + Символы.ПС + "• " + Ошибка;
            КонецЦикла;
        КонецЕсли;

        ЗаписьЖурналаРегистрации(
            "Выгрузка графиков в HR",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            ТекстСообщения
        );

        Сообщить(ТекстСообщения);

    Иначе
        ВызватьИсключение "Сервер вернул ошибку: " + ДанныеОтвета.error;
    КонецЕсли;

КонецПроцедуры

// Обработка ошибки от сервера
//
// Параметры:
//   Ответ - HTTPОтвет
//
Процедура ОбработатьОшибку(Ответ)

    ТекстОшибки = Ответ.ПолучитьТелоКакСтроку();

    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТекстОшибки);
        ДанныеОшибки = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();

        Если ДанныеОшибки.Свойство("error") Тогда
            ТекстОшибки = ДанныеОшибки.error;
        КонецЕсли;
    Исключение
        // JSON не распарсился, используем текст как есть
    КонецПопытки;

    ТекстСообщения = СтрШаблон(
        "❌ Ошибка импорта графиков (HTTP %1):%2%3",
        Ответ.КодСостояния,
        Символы.ПС,
        ТекстОшибки
    );

    ЗаписьЖурналаРегистрации(
        "Выгрузка графиков в HR",
        УровеньЖурналаРегистрации.Ошибка,
        ,
        ,
        ТекстСообщения
    );

    ВызватьИсключение ТекстСообщения;

КонецПроцедуры

#КонецОбласти

