#Область ПрограммныйИнтерфейс

// Основная процедура выгрузки графиков
//
// Параметры:
//   НачалоПериода - Дата - начало периода выгрузки
//   КонецПериода - Дата - конец периода выгрузки
//   СписокГрафиков - Массив - массив ссылок на справочник ГрафикиРаботы (необязательно)
//
Процедура ВыгрузитьГрафики(НачалоПериода, КонецПериода, СписокГрафиков = Неопределено) Экспорт

    // Проверка параметров
    Если Не ЗначениеЗаполнено(НачалоПериода) Или Не ЗначениеЗаполнено(КонецПериода) Тогда
        ВызватьИсключение "Не указан период выгрузки";
    КонецЕсли;

    Если КонецПериода < НачалоПериода Тогда
        ВызватьИсключение "Конец периода не может быть раньше начала";
    КонецЕсли;

    // Получение списка графиков для выгрузки
    Если СписокГрафиков = Неопределено Тогда
        СписокГрафиков = ПолучитьВсеАктивныеГрафики();
    КонецЕсли;

    Если СписокГрафиков.Количество() = 0 Тогда
        Сообщить("Нет графиков для выгрузки");
        Возврат;
    КонецЕсли;

    // Подготовка данных
    МассивГрафиков = Новый Массив;

    Для Каждого ГрафикСсылка Из СписокГрафиков Цикл
        Попытка
            ДанныеГрафика = ПодготовитьДанныеГрафика(ГрафикСсылка, НачалоПериода, КонецПериода);
            МассивГрафиков.Добавить(ДанныеГрафика);
        Исключение
            ТекстОшибки = СтрШаблон(
                "Ошибка подготовки графика '%1': %2",
                ГрафикСсылка,
                ОписаниеОшибки()
            );
            ЗаписьЖурналаРегистрации(
                "Выгрузка графиков в HR",
                УровеньЖурналаРегистрации.Ошибка,
                ,
                ГрафикСсылка,
                ТекстОшибки
            );
        КонецПопытки;
    КонецЦикла;

    Если МассивГрафиков.Количество() = 0 Тогда
        Сообщить("Не удалось подготовить данные графиков");
        Возврат;
    КонецЕсли;

    // Отправка данных
    ОтправитьГрафикиВHRСистему(МассивГрафиков);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получение всех активных графиков работы
//
// Возвращаемое значение:
//   Массив - массив ссылок на графики
//
Функция ПолучитьВсеАктивныеГрафики()

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ГрафикиРаботы.Ссылка КАК График
    |ИЗ
    |    Справочник.ГрафикиРаботы КАК ГрафикиРаботы
    |ГДЕ
    |    НЕ ГрафикиРаботы.ПометкаУдаления";

    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();

    МассивГрафиков = Новый Массив;
    Пока Выборка.Следующий() Цикл
        МассивГрафиков.Добавить(Выборка.График);
    КонецЦикла;

    Возврат МассивГрафиков;

КонецФункции

// Подготовка данных одного графика для отправки
//
// Параметры:
//   ГрафикСсылка - СправочникСсылка.ГрафикиРаботы
//   НачалоПериода - Дата
//   КонецПериода - Дата
//
// Возвращаемое значение:
//   Структура - данные графика
//
Функция ПодготовитьДанныеГрафика(ГрафикСсылка, НачалоПериода, КонецПериода)

    График = Новый Структура;
    График.Вставить("НаименованиеГрафика", ГрафикСсылка.Наименование);
    График.Вставить("КодГрафика", Строка(ГрафикСсылка.УникальныйИдентификатор()));

    // 🆕 НОВОЕ! Получение организаций для графика
    МассивОрганизаций = ПолучитьОрганизацииДляГрафика(ГрафикСсылка);
    График.Вставить("Организации", МассивОрганизаций);

    // Получение рабочих дней
    МассивРабочихДней = ПолучитьРабочиеДниГрафика(ГрафикСсылка, НачалоПериода, КонецПериода);
    График.Вставить("РабочиеДни", МассивРабочихДней);

    Возврат График;

КонецФункции

// 🆕 Получение списка организаций для графика
//
// Параметры:
//   ГрафикСсылка - СправочникСсылка.ГрафикиРаботы
//
// Возвращаемое значение:
//   Массив - массив БИНов организаций
//
Функция ПолучитьОрганизацииДляГрафика(ГрафикСсылка)

    МассивБИН = Новый Массив;

    // ВАРИАНТ 1: Если организации хранятся в табличной части "Организации" справочника "ГрафикиРаботы"
    Для Каждого СтрокаОрг Из ГрафикСсылка.Организации Цикл
        Если ЗначениеЗаполнено(СтрокаОрг.Организация) Тогда
            БИН = СокрЛП(СтрокаОрг.Организация.ИНН); // Или поле БИН
            Если ПроверитьБИН(БИН) Тогда
                МассивБИН.Добавить(БИН);
            Иначе
                ТекстПредупреждения = СтрШаблон(
                    "Некорректный БИН '%1' для организации '%2' в графике '%3'",
                    БИН,
                    СтрокаОрг.Организация,
                    ГрафикСсылка
                );
                ЗаписьЖурналаРегистрации(
                    "Выгрузка графиков в HR",
                    УровеньЖурналаРегистрации.Предупреждение,
                    ,
                    ГрафикСсылка,
                    ТекстПредупреждения
                );
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    // ВАРИАНТ 2: Если нужно определить организации через сотрудников
    // Раскомментируйте этот блок, если используете второй вариант
    /*
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |    Сотрудники.Организация.ИНН КАК БИН
    |ИЗ
    |    Справочник.Сотрудники КАК Сотрудники
    |ГДЕ
    |    Сотрудники.ГрафикРаботы = &График
    |    И Сотрудники.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
    |    И НЕ Сотрудники.ПометкаУдаления";

    Запрос.УстановитьПараметр("График", ГрафикСсылка);
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();

    Пока Выборка.Следующий() Цикл
        БИН = СокрЛП(Выборка.БИН);
        Если ПроверитьБИН(БИН) Тогда
            МассивБИН.Добавить(БИН);
        КонецЕсли;
    КонецЦикла;
    */

    // Удаление дубликатов
    МассивБИН = УдалитьДубликатыИзМассива(МассивБИН);

    Возврат МассивБИН;

КонецФункции

// Проверка корректности БИН
//
// Параметры:
//   БИН - Строка - БИН для проверки
//
// Возвращаемое значение:
//   Булево - Истина, если БИН корректный
//
Функция ПроверитьБИН(БИН)

    БИН = СокрЛП(БИН);

    // Проверка длины (12 цифр)
    Если СтрДлина(БИН) <> 12 Тогда
        Возврат Ложь;
    КонецЕсли;

    // Проверка что только цифры
    Для Индекс = 1 По СтрДлина(БИН) Цикл
        Символ = Сред(БИН, Индекс, 1);
        Если НЕ (Символ >= "0" И Символ <= "9") Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;

    Возврат Истина;

КонецФункции

// Удаление дубликатов из массива
//
// Параметры:
//   Массив - Массив - исходный массив
//
// Возвращаемое значение:
//   Массив - массив без дубликатов
//
Функция УдалитьДубликатыИзМассива(Массив)

    Карта = Новый Соответствие;
    Для Каждого Элемент Из Массив Цикл
        Карта.Вставить(Элемент, Истина);
    КонецЦикла;

    РезультатМассив = Новый Массив;
    Для Каждого КлючЗначение Из Карта Цикл
        РезультатМассив.Добавить(КлючЗначение.Ключ);
    КонецЦикла;

    Возврат РезультатМассив;

КонецФункции

// Получение рабочих дней графика за период
//
// Параметры:
//   ГрафикСсылка - СправочникСсылка.ГрафикиРаботы
//   НачалоПериода - Дата
//   КонецПериода - Дата
//
// Возвращаемое значение:
//   Массив - массив рабочих дней
//
Функция ПолучитьРабочиеДниГрафика(ГрафикСсылка, НачалоПериода, КонецПериода)

    МассивДней = Новый Массив;
    ТекущаяДата = НачалоПериода;

    Пока ТекущаяДата <= КонецПериода Цикл

        // Получение данных дня из графика
        // ПРИМЕЧАНИЕ: Эта функция должна быть реализована в соответствии
        // со структурой вашего справочника ГрафикиРаботы
        ДанныеДня = ПолучитьДанныеДняГрафика(ГрафикСсылка, ТекущаяДата);

        РабочийДень = Новый Структура;
        РабочийДень.Вставить("Дата", Формат(ТекущаяДата, "ДФ=yyyy-MM-dd"));
        РабочийДень.Вставить("Месяц", Формат(НачалоМесяца(ТекущаяДата), "ДФ=yyyy-MM-dd"));
        РабочийДень.Вставить("ВидУчетаВремени", ДанныеДня.ВидУчетаВремени);
        РабочийДень.Вставить("ДополнительноеЗначение", ДанныеДня.КоличествоЧасов);

        // Время работы (опционально)
        Если ЗначениеЗаполнено(ДанныеДня.ВремяНачала) Тогда
            РабочийДень.Вставить("ВремяНачалоРаботы", Формат(ДанныеДня.ВремяНачала, "ДФ=HH:mm:ss"));
        КонецЕсли;

        Если ЗначениеЗаполнено(ДанныеДня.ВремяОкончания) Тогда
            РабочийДень.Вставить("ВремяЗавершениеРаботы", Формат(ДанныеДня.ВремяОкончания, "ДФ=HH:mm:ss"));
        КонецЕсли;

        МассивДней.Добавить(РабочийДень);

        ТекущаяДата = ТекущаяДата + 86400; // +1 день

    КонецЦикла;

    Возврат МассивДней;

КонецФункции

